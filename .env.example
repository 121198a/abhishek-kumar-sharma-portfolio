# ── CANONICAL SITE CONFIGURATION (Optional in local development) ─────
# Defines the canonical base URL for metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://abhishek-portfolio.vercel.app

# ── FEATURE FLAGS (server-controlled) ───────────────────────────────
# Flip these to disable a feature instantly without code changes.
ENABLE_AI=true
ENABLE_ANALYTICS=false
ENABLE_CONTACT_FORM=true

# Analytics events are same-origin, consent-gated (cookie banner "Accept
# All"), and only persist at all when ENABLE_ANALYTICS=true above. No IP,
# name, email, question text or message content is ever stored — only a
# fixed set of event names plus a short project/category label. This limit
# is a flood/abuse guard on the collection endpoint itself, reusing the
# same in-memory rate limiter as /api/chat and /api/contact.
ANALYTICS_RATE_LIMIT_PER_IP_PER_MINUTE=40

# ── AI (NVIDIA NIM) ──────────────────────────────────────────────────
# Get a key at https://build.nvidia.com — always re-check current free-tier
# limits and model availability before relying on this in production.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# ── Phase 2: lightweight RAG (supplements, never replaces, the structured
# KB above). Self-disables if no index has been built or NVIDIA_API_KEY is
# missing — safe to leave on. Run `npm run index:knowledge` after changing
# data/faq.ts to (re)generate data/embeddings.generated.json.
ENABLE_RAG=true
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Usage guardrails — the /api/chat route enforces these server-side.
AI_DAILY_LIMIT=20
AI_MAX_MESSAGES_PER_SESSION=10
AI_MAX_INPUT_CHARS=400
AI_MAX_OUTPUT_TOKENS=512
AI_REQUEST_TIMEOUT_MS=10000
AI_RATE_LIMIT_PER_IP_PER_MINUTE=5

# ── EMAIL (Resend free tier) ────────────────────────────────────────
# Get a free key at https://resend.com — free tier as of writing is
# 3,000 emails/month, 100/day. Always re-check current limits.
RESEND_API_KEY=
CONTACT_TO_EMAIL=sharmaabhishek121198@gmail.com
# Resend's onboarding@resend.dev sender works without domain verification,
# but ONLY delivers to the email address your Resend account itself was
# created with. Since CONTACT_TO_EMAIL above is that same address, this
# default works out of the box for this form specifically. It will 403 if
# CONTACT_TO_EMAIL is ever changed to an address different from the
# Resend account owner's email — at that point, verify your own domain at
# resend.com/domains and set CONTACT_FROM_EMAIL to an address on it
# (e.g. contact@yourdomain.com) instead.
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_RATE_LIMIT_PER_IP_PER_HOUR=3

# ── OPTIONAL: Supabase (only needed once you add persistence, e.g.
# storing contact submissions or recruiter analytics). Not required for
# the portfolio to function. ─────────────────────────────────────────

# Secret for signing the chat session-count cookie. Generate with: openssl rand -hex 32
CHAT_SESSION_SECRET=

# ── GITHUB (optional) ────────────────────────────────────────────────
# The "Code on GitHub" section fetches public repo data server-side, cached
# 24 h. No token is required (60 requests/hour per IP is plenty), but shared
# build IPs can be rate limited, so a read-only token is recommended:
# GitHub > Settings > Developer settings > Fine-grained token, public
# repositories, NO permissions. Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=
