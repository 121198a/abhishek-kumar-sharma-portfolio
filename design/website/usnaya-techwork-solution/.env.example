# Client-safe (public) values only. Never put secrets in VITE_ variables.
VITE_APP_NAME=USNAYA Techworks Solution 3D Project

# Server-only values (used by server/, never shipped to the browser)
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173
# local = answers only from server/knowledge/companyKnowledge.ts (no external AI)
# anthropic = calls the Anthropic Messages API (needs the two values below)
AI_PROVIDER=local
AI_PROVIDER_API_KEY=replace-with-secret
AI_PROVIDER_MODEL=replace-with-approved-model
DAILY_REQUEST_CAP=500
